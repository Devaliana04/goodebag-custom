{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/paket", "destination": "/produk", "permanent": true },
    { "source": "/paket/seminar-workshop", "destination": "/produk/seminar-workshop", "permanent": true },
    { "source": "/paket/corporate-kantor", "destination": "/produk/corporate-kantor", "permanent": true },
    { "source": "/paket/event-promosi", "destination": "/produk/event-promosi", "permanent": true },
    { "source": "/paket/sekolah-komunitas", "destination": "/produk/sekolah-komunitas", "permanent": true },
    { "source": "/paket/pernikahan-acara", "destination": "/produk/pernikahan-acara", "permanent": true },
    { "source": "/paket/custom", "destination": "/produk/custom", "permanent": true },
    { "source": "/paket-seminar-workshop", "destination": "/produk-seminar-workshop", "permanent": true },
    { "source": "/paket-corporate-kantor", "destination": "/produk-corporate-kantor", "permanent": true },
    { "source": "/paket-event-promosi", "destination": "/produk-event-promosi", "permanent": true },
    { "source": "/paket-sekolah-komunitas", "destination": "/produk-sekolah-komunitas", "permanent": true },
    { "source": "/paket-pernikahan-acara", "destination": "/produk-pernikahan-acara", "permanent": true },
    { "source": "/paket-custom", "destination": "/produk-custom", "permanent": true },
    { "source": "/blog/panduan-goodie-bag", "destination": "/blog/panduan-totebag", "permanent": true },
    { "source": "/blog/jenis-bahan-goodie-bag", "destination": "/blog/jenis-bahan-totebag", "permanent": true },
    { "source": "/blog/ide-isi-goodie-bag-seminar", "destination": "/blog/ide-isi-totebag-seminar", "permanent": true }
  ],
  "rewrites": [
    { "source": "/produk", "destination": "/produk.html" },
    { "source": "/produk/seminar-workshop", "destination": "/produk-seminar-workshop.html" },
    { "source": "/produk/corporate-kantor", "destination": "/produk-corporate-kantor.html" },
    { "source": "/produk/event-promosi", "destination": "/produk-event-promosi.html" },
    { "source": "/produk/sekolah-komunitas", "destination": "/produk-sekolah-komunitas.html" },
    { "source": "/produk/pernikahan-acara", "destination": "/produk-pernikahan-acara.html" },
    { "source": "/produk/custom", "destination": "/produk-custom.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/blog/panduan-totebag", "destination": "/blog-panduan-totebag.html" },
    { "source": "/blog/jenis-bahan-totebag", "destination": "/blog-jenis-bahan-totebag.html" },
    { "source": "/blog/ide-isi-totebag-seminar", "destination": "/blog-ide-isi-totebag-seminar.html" },
    { "source": "/tentang", "destination": "/tentang.html" },
    { "source": "/portofolio", "destination": "/portofolio.html" },
    { "source": "/kontak", "destination": "/kontak.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/cara-pesan", "destination": "/cara-pesan.html" },
    { "source": "/kebijakan-privasi", "destination": "/kebijakan-privasi.html" },
    { "source": "/syarat-ketentuan", "destination": "/syarat-ketentuan.html" }
  ]
}
